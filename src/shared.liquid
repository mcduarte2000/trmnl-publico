{%- assign topic_label = trmnl.plugin_settings.custom_fields_values.topic | default: "http://feeds.feedburner.com/PublicoRSS" %}
{%- assign topic_map = "Geral:http://feeds.feedburner.com/PublicoRSS,Ciência:http://feeds.feedburner.com/PublicoCiencias,Cultura:http://feeds.feedburner.com/Publicocultura,Economia:http://feeds.feedburner.com/PublicoEconomia,Local:http://feeds.feedburner.com/PublicoLocal,Media:http://feeds.feedburner.com/Publico-Media,Mundo:http://feeds.feedburner.com/PublicoMundo,P3:http://feeds.feedburner.com/PublicoP3,Sociedade:http://feeds.feedburner.com/PublicoSociedade,Tecnologia:http://feeds.feedburner.com/PublicoTecnologia" | split: "," %}
{%- for pair in topic_map %}
  {%- assign parts = pair | split: ":" %}
  {%- if parts[1] == topic_label %}
    {%- assign topic_label = parts[0] %}
  {%- endif %}
{%- endfor %}