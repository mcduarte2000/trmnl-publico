<div class="layout layout--col gap">
  {% if rss and rss.channel and rss.channel.item %}
    <div class="columns" data-overflow-max-cols="2" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg="3">
      <div class="column">
        {% for item in rss.channel.item limit: 10 %}
          <div class="item gap--xsmall">
            <div class="meta">
              <span class="index text--small">{{ forloop.index }}</span>
            </div>
            <div class="content">
              <span class="title title--small" data-clamp="2">{{ item.title }}</span>
              <span class="label label--xsmall label--gray">{{ item.category }}&nbsp;&middot;&nbsp;{% render "time_ago" with published_date: item.pubDate %}</span>
              <span class="description description--xsmall hidden lg:block" data-clamp="2">{{ item.description | strip_html }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="flex flex--col flex--center gap">
      <span class="title">No articles available</span>
      <span class="label label--gray">Check your feed configuration</span>
    </div>
  {% endif %}
</div>

{{ title_bar }}