<div class="layout layout--col gap--small">
  {% if rss and rss.channel and rss.channel.item %}
    <div class="columns" data-overflow-max-cols="1">
      <div class="column">
        {% for item in rss.channel.item limit: 5 %}
          <div class="item">
            <div class="meta">
              <span class="index w--10 lg:w--12">{{ forloop.index }}</span>
            </div>
            <div class="content">
              <span class="title title--xsmall lg:title--small">{{ item.title }}</span>
              <span class="label label--xsmall label--gray lg:label--small">{{ item.category }} · {% render "time_ago" with date: item.pubDate %}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="flex flex--col flex--center gap">
      <span class="title">No articles available</span>
      <span class="label label--gray">Check your feed configuration</span>
    </div>
  {% endif %}
</div>
{{ title_bar }}