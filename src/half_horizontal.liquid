<div class="layout layout--row gap">
  <div class="columns" data-overflow-max-cols="3">
    <div class="column">
      {% for item in rss.channel.item limit: 6 %}
        <div class="item">
          <div class="meta">
            <span class="index w--10">
              {{ forloop.index }}
            </span>
          </div>
          <div class="content">
            <span class="title title--xsmall">
              {{ item.title }}
            </span>
            <span class="label label--xsmall label--gray">
              {{ item.category }}
            </span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{{ title_bar }}